# Campaign generation uses an AI provider when configured, with a built-in template fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=auto

# Optional OpenAI API fallback. OpenAI API usage is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional image generation. Keep this account token server-side in backend/.env.
# The Cloudflare Workers Free plan includes a daily AI allowance; LocalLift never upgrades plans.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Comma-separated addresses permitted to call this local API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
