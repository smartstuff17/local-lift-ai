# Copy to .env.local, then fill in values from your Supabase project.
# These are the project's URL and publishable key; never put a secret/service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development API; set the production backend URL when deploying.
VITE_API_URL=http://localhost:8000

